<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1.4.0-002-seed-products" author="sreeyukthag">
        <loadData tableName="products" file="products.csv" relativeToChangelogFile="true">
            <column name="id" type="UUID"/>
            <column name="name" type="STRING"/>
            <column name="category" type="STRING"/>
            <column name="price_cents" type="NUMERIC"/>
            <column name="stock" type="NUMERIC"/>
            <column name="rating" type="NUMERIC"/>
            <column name="created_at" type="DATE"/>
            <column name="updated_at" type="DATE"/>
        </loadData>

        <rollback>
            <delete tableName="products"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
